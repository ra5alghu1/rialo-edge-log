[Unit]
Description=Rialo Edge Log archive publisher
After=network-online.target rialo-edge-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/rialo-edge-log/edge.env
ExecStart=@REPO_ROOT@/.venv/bin/python -m gateway.archive_publisher watch --include-existing --data-dir /var/lib/rialo-edge-log/data --publication-dir /var/lib/rialo-edge-log/data/publications-vps --heartbeat-dir /var/lib/rialo-edge-log/data/heartbeats --archive-url ${RIALO_ARCHIVE_URL} --ingest-token ${RIALO_EDGE_LOG_INGEST_TOKEN}
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
